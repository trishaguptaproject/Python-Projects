        hd = tk.Frame(pg, bg=NAVY, padx=16, pady=10); hd.pack(fill="x")
        lbl(hd, "Registered Customers", F["title"], BG, NAVY).pack(side="left")
        tf = tk.Frame(pg, bg=BG, padx=12, pady=6); tf.pack(fill="both", expand=True)
        cols=("Customer ID","Full Name","Email","Phone","License","Joined")
        self._ct2, sb = tree(tf, cols)
        self._ct2.pack(side="left",fill="both",expand=True); sb.pack(side="right",fill="y")
        return pg

    def _load_vehicles(self):
        for r in self._avt.get_children(): self._avt.delete(r)
        flt = self._avf.get()
        for v in get_vehicles():
            i = v.info()
            if flt!="All":
                if flt in ("available","rented") and i["status"].lower()!=flt: continue
                if flt in ("Car","Bike","Truck") and i["vehicle_type"]!=flt: continue
            self._avt.insert("","end", values=(
                i["vehicle_id"],i["vehicle_type"],i["brand_model"],i["reg_number"],
                i["year"],i["fuel_type"].title(),i["capacity_label"],
                f"Rs.{i['rate_per_day']:.0f}",f"Rs.{i['security_dep']:.0f}",i["status"].title()))

    def _do_add(self):
        try:
            cp,rt,dp,yr = self._fcp.get().strip(),self._frt.get().strip(),self._fd.get().strip(),self._fy.get().strip()
            if not all([cp,rt,dp,yr,self._fb.get().strip(),self._fr.get().strip()]):
                raise ValidationError("All fields required.")
            try: cp,rt,dp,yr = float(cp),float(rt),float(dp),int(yr)
            except ValueError: raise ValidationError("Capacity, rate, deposit, year must be numbers.")
            if rt<=0 or dp<=0 or cp<=0: raise ValidationError("Rate, deposit, capacity must be positive.")
            vid = add_vehicle(self._ft.get(),self._fb.get(),self._fr.get(),yr,
                              self._fc.get(),self._ff.get(),cp,rt,dp)
            self.ok("Added", f"Vehicle added! ID: {vid}"); self._clr()
        except VRSError as ex: self.err("Failed", ex.message)

    def _clr(self):
        for v in [self._fb,self._fr,self._fy,self._fc,self._fcp,self._frt,self._fd]: v.set("")
        self._ft.set("car"); self._ff.set("petrol")

    def _do_del(self):
        vid = self._dv.get().strip().upper()
        if not vid: self.err("Required","Enter a Vehicle ID."); return
        try:
            v = get_vehicle(vid)
            if not self.ask("Confirm",f"Delete {v.brand_model} ({vid})?"): return
            del_vehicle(vid); self.ok("Deleted",f"{vid} deleted."); self._dv.set("")
            self._load_vehicles()
        except VRSError as ex: self.err("Failed", ex.message)

    def _logout(self):
        if self.ask("Logout","Are you sure?"): self.on_logout()

    def refresh(self):
        if self._active=="d": self._load_dash()
        elif self._active=="v": self._load_vehicles()
        elif self._active=="r": self._load_rentals()
        elif self._active=="c": self._load_customers()

    def _load_dash(self):
        st = stats()
        for k,l in self._sl.items():
            v = st.get(k,0); l.config(text=f"{v:.0f}" if isinstance(v,float) else str(v))
        for r in self._rt.get_children(): self._rt.delete(r)
        for r in all_rentals()[:10]:
            self._rt.insert("","end", values=(
                r["rental_id"],r.get("full_name",""),r.get("brand_model",""),
                r["start_date"],r["end_date"],
                f"Rs.{r['total_amount']:.0f}",r["status"].title()))

    def _load_rentals(self):
        for r in self._rnt.get_children(): self._rnt.delete(r)
        for r in all_rentals():
            self._rnt.insert("","end", values=(
                r["rental_id"],r.get("full_name",""),r.get("brand_model",""),
                r["start_date"],r["end_date"],r.get("return_date") or "-",r["total_days"],
                f"Rs.{r['base_charge']:.0f}",f"Rs.{r['late_fee']:.0f}",
                f"Rs.{r['total_amount']:.0f}",r["status"].title()))

    def _load_customers(self):
        for r in self._ct2.get_children(): self._ct2.delete(r)
        for c in all_customers():
            self._ct2.insert("","end", values=(
                c["customer_id"],c["full_name"],c["email"],c["phone"],
                c["license_no"],c["created_at"][:10]))

# APP CONTROLLER
class App:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Vehicle Rental System")
        self.root.geometry("1200x720")
        self.root.minsize(1000, 640)
        self.root.configure(bg=BG)
        x = self.root.winfo_screenwidth()//2 - 600
        y = self.root.winfo_screenheight()//2 - 360
        self.root.geometry(f"1200x720+{x}+{y}")
        self._win = None
        try: init_db()
        except DBError as e: messagebox.showerror("DB Error", e.message); sys.exit(1)
        self._show_login()

    def _clear(self):
        if self._win:
            try: self._win.destroy()
            except: pass
        self._win = None

    def _show_login(self):
        self._clear()
        w = LoginWin(self.root, self._user_ok, self._admin_ok)
        w.on_reg = self._show_reg; w.show(); self._win = w

    def _show_reg(self):
        self._clear()
        w = RegisterWin(self.root, self._show_login, self._show_login)
        w.show(); self._win = w

    def _user_ok(self, data):
        self._clear()
        w = UserDash(self.root, data, self._show_login)
        w.show(); self._win = w

    def _admin_ok(self, data):
        self._clear()
        w = AdminDash(self.root, data, self._show_login)
        w.show(); self._win = w

    def run(self): self.root.mainloop()

if __name__ == "__main__":
    App().run()
