def apply_style():
    s = ttk.Style(); s.theme_use("clam")
    s.configure("T.Treeview",
                background=BG, foreground=TXT,
                fieldbackground=BG, rowheight=24,
                font=F["body"], borderwidth=1)
    s.configure("T.Treeview.Heading",
                background=NAVY, foreground=BG,
                font=F["sub"], relief="flat", padding=4)
    s.map("T.Treeview",
          background=[("selected", NAVY)],
          foreground=[("selected", BG)])

def btn(p, text, cmd, bg=None, w=None, **kw): #styled button automatically
    b = tk.Button(p, text=text, command=cmd,
                  bg=bg or NAVY, fg=BG,
                  font=F["btn"], relief="solid", bd=1,
                  cursor="hand2", padx=8, pady=5)
    if w: b.config(width=w)
    return b

def lbl(p, text, font=None, fg=None, bg=None, **kw):
    return tk.Label(p, text=text,
                    font=font or F["body"],
                    fg=fg or TXT,
                    bg=bg or BG, **kw)

def entry(p, var, show=None, w=28): #create text i/p
    f = tk.Frame(p, bg=NAVY, pady=1, padx=1)
    e = tk.Entry(f, textvariable=var, show=show,
                 bg=ENTRY_BG, fg=TXT,
                 insertbackground=TXT,
                 relief="flat", font=F["body"], bd=3, width=w)
    e.pack(fill="x"); return f, e

def tree(p, cols, h=13):
    apply_style()
    t = ttk.Treeview(p, columns=cols, show="headings",
                     style="T.Treeview", height=h, selectmode="browse")
    for c in cols:
        t.heading(c, text=c)
        t.column(c, anchor="center", width=110, minwidth=70)
    sb = ttk.Scrollbar(p, orient="vertical", command=t.yview)
    t.configure(yscrollcommand=sb.set)
    return t, sb

def field_row(p, label, var, row, show=None):
    lbl(p, label, font=F["body"], fg=MUTE, bg=p["bg"]).grid(
        row=row, column=0, sticky="w", pady=3, padx=(0, 10))
    f, e = entry(p, var, show=show)
    f.grid(row=row, column=1, sticky="ew", pady=3)
    return e

# BASE WINDOW
class BaseWin(ABC):
    def __init__(self, parent, session):
        self.parent = parent; self.session = session
        self.frame = tk.Frame(parent, bg=BG) #PC for all GUI

    @abstractmethod
    def build_ui(self): pass
    @abstractmethod
    def refresh(self): pass

    def show(self):    self.frame.pack(fill="both", expand=True)
    def hide(self):    self.frame.pack_forget()
    def destroy(self): self.frame.destroy()
    def err(self, t, m):  messagebox.showerror(t, m)
    def ok(self, t, m):   messagebox.showinfo(t, m)
    def ask(self, t, m):  return messagebox.askyesno(t, m)

