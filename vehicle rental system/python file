        pg = tk.Frame(self._ct, bg=BG)
        hd = tk.Frame(pg, bg=NAVY, padx=16, pady=10); hd.pack(fill="x")
        lbl(hd, "Return a Vehicle", F["title"], BG, NAVY).pack(side="left")

        fm = tk.Frame(pg, bg=BG, padx=26, pady=20); fm.pack()
        lbl(fm, "Enter your Rental ID to return:", F["sub"], bg=BG).pack(anchor="w", pady=(0,10))
        rr = tk.Frame(fm, bg=BG); rr.pack(anchor="w")
        lbl(rr, "Rental ID:", F["body"], MUTE, BG).pack(side="left", padx=(0,6))
        self._rid = tk.StringVar()
        f, _ = entry(rr, self._rid, w=16); f.pack(side="left")
        btn(fm, "Process Return", self._do_return).pack(anchor="w", pady=12)

        ic = tk.Frame(pg, bg=LTBG, padx=16, pady=14, relief="solid", bd=1)
        ic.pack(fill="x", padx=26)
        self._inv = tk.Text(ic, bg=LTBG, fg=TXT, font=F["mono"],
                            height=12, relief="flat", state="disabled", wrap="none")
        self._inv.pack(fill="x")
        return pg

    def _pg_history(self):
        pg = tk.Frame(self._ct, bg=BG)
        hd = tk.Frame(pg, bg=NAVY, padx=16, pady=10); hd.pack(fill="x")
        lbl(hd, "Rental History", F["title"], BG, NAVY).pack(side="left")
        tf = tk.Frame(pg, bg=BG, padx=12, pady=6); tf.pack(fill="both", expand=True)
        cols=("Rental ID","Vehicle","Start","End","Returned","Days","Total","Status")
        self._ht, sb = tree(tf, cols)
        self._ht.pack(side="left",fill="both",expand=True); sb.pack(side="right",fill="y")
        return pg

    def _load_vehicles(self):
        for r in self._vt.get_children(): self._vt.delete(r)
        flt = self._vf.get()
        for v in get_vehicles("available"):
            i = v.info()
            if flt!="All" and i["vehicle_type"]!=flt: continue
            self._vt.insert("","end", values=(
                i["vehicle_id"], i["vehicle_type"], i["brand_model"], i["year"],
                i["color"], i["fuel_type"].title(), i["capacity_label"],
                f"Rs.{i['rate_per_day']:.0f}", f"Rs.{i['insurance']:.0f}", i["status"].title()))

    def _do_rent(self):
        try:
            v,s,e = self._rv.get().strip().upper(), self._rs.get().strip(), self._re.get().strip()
            if not v or not s or not e: raise ValidationError("All rent fields required.")
            rid = create_rental(self.session["customer_id"], v, s, e)
            self.ok("Confirmed", f"Rental created!\nRental ID: {rid}")
            for x in [self._rv,self._rs,self._re]: x.set("")
            self._load_vehicles()
        except VRSError as ex: self.err("Failed", ex.message)

    def _do_return(self):
        try:
            rid = self._rid.get().strip().upper()
            if not rid: raise ValidationError("Enter a Rental ID.")
            if not self.ask("Confirm", f"Return rental {rid}?"): return
            inv = return_rental(rid)
            late_ln = (f"  Late Days : {inv['late_days']} day(s)\n"
                       f"  Late Fee  : Rs.{inv['late_fee']:.2f}\n"
                       if inv["late_days"]>0 else
                       "  Late Fee  : Rs.0.00 (on time)\n")
            txt = (f"{'='*40}\n  RETURN INVOICE\n{'='*40}\n"
                   f"  Rental ID : {inv['rental_id']}\n"
                   f"  Vehicle   : {inv['brand_model']}\n"
                   f"  Rented On : {inv['start_date']}\n"
                   f"  Due Date  : {inv['end_date']}\n"
                   f"  Returned  : {inv['return_date']}\n"
                   f"{'-'*40}\n"
                   f"  Base      : Rs.{inv['base_charge']:.2f}\n"
                   f"{late_ln}"
                   f"  Security  : Rs.{inv['security_dep']:.2f} (Refunded)\n"
                   f"{'-'*40}\n"
                   f"  TOTAL DUE : Rs.{inv['total_due']:.2f}\n{'='*40}\n")
            self._inv.config(state="normal"); self._inv.delete("1.0","end")
            self._inv.insert("end", txt); self._inv.config(state="disabled")
            self._rid.set("")
        except VRSError as ex: self.err("Failed", ex.message)

    def _logout(self):
        if self.ask("Logout","Are you sure?"): self.on_logout()

    def refresh(self):
        if self._active=="v": self._load_vehicles()
        elif self._active=="a": self._load_active()
        elif self._active=="h": self._load_history()

    def _load_active(self):
        for r in self._at.get_children(): self._at.delete(r)
        for r in user_rentals(self.session["customer_id"]):
            if r["status"]=="active":
                self._at.insert("","end", values=(
                    r["rental_id"],r["brand_model"],r["start_date"],r["end_date"],
                    r["total_days"],f"{r['base_charge']:.2f}",f"{r['security_dep']:.2f}",
                    f"{r['total_amount']:.2f}",r["status"].title()))

    def _load_history(self):
        for r in self._ht.get_children(): self._ht.delete(r)
        for r in user_rentals(self.session["customer_id"]):
            self._ht.insert("","end", values=(
                r["rental_id"],r["brand_model"],r["start_date"],r["end_date"],
                r.get("return_date") or "-",r["total_days"],
                f"{r['total_amount']:.2f}",r["status"].title()))

