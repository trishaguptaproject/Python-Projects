DB = os.path.join(os.path.dirname(os.path.abspath(__file__)), "vrs.db")

def conn():
    try:
        c = sqlite3.connect(DB, timeout=10); c.row_factory = sqlite3.Row
        c.execute("PRAGMA foreign_keys=ON"); return c
    except sqlite3.Error as e: raise DBError(f"DB connect failed: {e}")

def init_db():
    try:
        db = conn(); db.executescript("""
            CREATE TABLE IF NOT EXISTS users(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                customer_id TEXT UNIQUE NOT NULL, full_name TEXT NOT NULL,
                email TEXT UNIQUE NOT NULL, phone TEXT UNIQUE NOT NULL,
                password TEXT NOT NULL, license_no TEXT UNIQUE NOT NULL,
                role TEXT DEFAULT 'user', created_at TEXT DEFAULT(datetime('now')));
            CREATE TABLE IF NOT EXISTS vehicles(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                vehicle_id TEXT UNIQUE NOT NULL, vehicle_type TEXT NOT NULL,
                brand_model TEXT NOT NULL, reg_number TEXT UNIQUE NOT NULL,
                year INTEGER NOT NULL, color TEXT NOT NULL, fuel_type TEXT NOT NULL,
                capacity REAL NOT NULL, rate_per_day REAL NOT NULL,
                security_dep REAL NOT NULL, status TEXT DEFAULT 'available',
                added_at TEXT DEFAULT(datetime('now')));
            CREATE TABLE IF NOT EXISTS rentals(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                rental_id TEXT UNIQUE NOT NULL, customer_id TEXT NOT NULL,
                vehicle_id TEXT NOT NULL, start_date TEXT NOT NULL,
                end_date TEXT NOT NULL, return_date TEXT, total_days INTEGER NOT NULL,
                base_charge REAL NOT NULL, late_fee REAL DEFAULT 0,
                security_dep REAL NOT NULL, total_amount REAL NOT NULL,
                status TEXT DEFAULT 'active', created_at TEXT DEFAULT(datetime('now')),
                FOREIGN KEY(customer_id) REFERENCES users(customer_id),
                FOREIGN KEY(vehicle_id) REFERENCES vehicles(vehicle_id));
            CREATE TABLE IF NOT EXISTS admins(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                admin_id TEXT UNIQUE NOT NULL, name TEXT NOT NULL, password TEXT NOT NULL);
        """)
        cur = db.cursor()
        if cur.execute("SELECT COUNT(*) FROM admins").fetchone()[0] == 0:
            db.execute("INSERT INTO admins VALUES(NULL,?,?,?)",
                       ("ADMIN-001","Super Admin", hashlib.sha256(b"Admin@123").hexdigest()))
        if cur.execute("SELECT COUNT(*) FROM vehicles").fetchone()[0] == 0:
            db.executemany(
                "INSERT INTO vehicles VALUES(NULL,?,?,?,?,?,?,?,?,?,?,'available',datetime('now'))",
                [("VEH-1001","car","Toyota Camry","GJ01AB1234",2022,"White","Petrol",5,1500,3000),
                 ("VEH-1002","car","Honda City","MH02CD5678",2021,"Silver","Petrol",5,1200,2500),
                 ("VEH-1003","bike","Royal Enfield","GJ05ZZ9999",2023,"Black","Petrol",350,600,1000),
                 ("VEH-1004","bike","KTM Duke","DL03EF1122",2022,"Orange","Petrol",200,500,800),
                 ("VEH-1005","truck","Tata Ace","UP32GH4455",2020,"Blue","Diesel",1.5,3000,5000)])
        db.commit(); db.close()
    except sqlite3.Error as e: raise DBError(f"DB init failed: {e}")

# AUTH SERVICE
_attempts = {}
MAX_ATT = 3 # it allowe 3email enter

def hsh(p): return hashlib.sha256(p.encode()).hexdigest()
def vpass(plain, h): return hsh(plain) == h #check the p valdition match

def chk_password(p): #password strength checking
    if len(p) < 8: raise WeakPassword("Min 8 characters.")
    if not re.search(r"[A-Z]", p): raise WeakPassword("Need uppercase letter.")
    if not re.search(r"[a-z]", p): raise WeakPassword("Need lowercase letter.")
    if not re.search(r"\d", p): raise WeakPassword("Need a digit.")
    if not re.search(r"[!@#$%^&*()_+\-=\[\]{};':\"\\|,.<>/?]", p): raise WeakPassword("Need a special character.")

def chk_email(e):
    if not re.match(r"^[\w\.-]+@[\w\.-]+\.\w{2,}$", e): raise BadEmail(f"Invalid email: {e}")
def chk_phone(p):
    if not re.match(r"^\d{10}$", p): raise BadPhone("Phone must be 10 digits.")
def chk_license(l): pass  # validation removed

def register(full_name, email, phone, license_no, password, confirm):
    chk_email(email.strip()); chk_phone(phone.strip())
    chk_license(license_no.strip()); chk_password(password)
    if password != confirm: raise ValidationError("Passwords do not match.")
    db = conn() #register valdation need
    try:
        cur = db.cursor()#pop message for register
        if cur.execute("SELECT 1 FROM users WHERE email=?", (email.lower(),)).fetchone():
            raise DuplicateUser("Email already registered.")
        if cur.execute("SELECT 1 FROM users WHERE phone=?", (phone,)).fetchone():
            raise DuplicateUser("Phone already registered.")
        if cur.execute("SELECT 1 FROM users WHERE license_no=?", (license_no.upper(),)).fetchone():
            raise DuplicateUser("License already registered.")
        cid = f"CUST-{1001 + cur.execute('SELECT COUNT(*) FROM users').fetchone()[0]}"
        db.execute("INSERT INTO users(customer_id,full_name,email,phone,password,license_no,role)"
                   " VALUES(?,?,?,?,?,?,'user')",
                   (cid, full_name.strip(), email.lower(), phone.strip(), hsh(password), license_no.upper()))
        db.commit(); return cid
    except (DuplicateUser, ValidationError): raise
    except Exception as e: raise DBError(f"Register failed: {e}")
    finally: db.close()

def login_user(email, password):
    k = email.lower()
    if _attempts.get(k, 0) >= MAX_ATT: raise AccountLocked("Account locked (3 fails).")
    db = conn()
    try:
        row = db.execute("SELECT * FROM users WHERE email=? AND role='user'", (k,)).fetchone()
        if row and vpass(password, row["password"]):
            _attempts[k] = 0; return dict(row)
        _attempts[k] = _attempts.get(k, 0) + 1
        raise BadCredentials(f"Wrong credentials. {MAX_ATT - _attempts[k]} left.")
    finally: db.close()

def login_admin(admin_id, password):
    k = f"adm_{admin_id}"
    if _attempts.get(k, 0) >= MAX_ATT: raise AccountLocked("Admin locked (3 fails).")
    db = conn()
    try:
        row = db.execute("SELECT * FROM admins WHERE admin_id=?", (admin_id.upper(),)).fetchone()
        if row and vpass(password, row["password"]):
            _attempts[k] = 0; return dict(row)
        _attempts[k] = _attempts.get(k, 0) + 1
        raise BadCredentials(f"Wrong credentials. {MAX_ATT - _attempts[k]} left.")
    finally: db.close()

# VEHICLE SERVICE- valdation for vehicle rental
def _next_vid():
    db = conn()
    n = db.execute("SELECT COUNT(*) FROM vehicles").fetchone()[0]; db.close()
    return f"VEH-{1001 + n}"

def add_vehicle(vtype, brand, reg, year, color, fuel, cap, rate, dep):
    if not brand.strip(): raise ValidationError("Brand cannot be empty.")
    if not re.match(r"^[A-Z]{2}\d{2}[A-Z]{1,2}\d{4}$", reg.upper()):
        raise ValidationError("Reg format: GJ01AB1234")
    db = conn()
    try:
        if db.execute("SELECT 1 FROM vehicles WHERE reg_number=?", (reg.upper(),)).fetchone():
            raise DuplicateReg(f"Reg '{reg}' already exists.")
        vid = _next_vid()
        db.execute("INSERT INTO vehicles(vehicle_id,vehicle_type,brand_model,reg_number,year,"
                   "color,fuel_type,capacity,rate_per_day,security_dep,status) VALUES(?,?,?,?,?,?,?,?,?,?,'available')",
                   (vid, vtype.lower(), brand.strip(), reg.upper(), int(year),
                    color.strip(), fuel.lower(), float(cap), float(rate), float(dep)))
        db.commit(); return vid
    except (DuplicateReg, ValidationError): raise
    except Exception as e: raise DBError(f"Add vehicle failed: {e}")
    finally: db.close()

def get_vehicles(status=None):
    db = conn()
    q = "SELECT * FROM vehicles" + (" WHERE status=?" if status else "") + " ORDER BY id"
    rows = [dict(r) for r in db.execute(q, (status,) if status else ()).fetchall()]
    db.close(); return [make_vehicle(r) for r in rows]

def get_vehicle(vid):
    db = conn()
    row = db.execute("SELECT * FROM vehicles WHERE vehicle_id=?", (vid,)).fetchone()
    db.close()
    if not row: raise VehicleNotFound(f"Vehicle '{vid}' not found.")
    return make_vehicle(dict(row))

def set_vstatus(vid, s):
    db = conn(); db.execute("UPDATE vehicles SET status=? WHERE vehicle_id=?", (s, vid))
    db.commit(); db.close()

def del_vehicle(vid):
    db = conn()
    if db.execute("SELECT COUNT(*) FROM rentals WHERE vehicle_id=? AND status='active'",
                  (vid,)).fetchone()[0] > 0:
        db.close(); raise NotAvailable("Cannot delete vehicle with active rental.")
    db.execute("DELETE FROM vehicles WHERE vehicle_id=?", (vid,))
    db.commit(); db.close()

# RENTAL SERVICE
FMT = "%Y-%m-%d"
def pdate(s): return datetime.strptime(s, FMT)
def today(): return datetime.now().strftime(FMT)

def _next_rid():
    db = conn()
    n = db.execute("SELECT COUNT(*) FROM rentals").fetchone()[0]; db.close()
    return f"RNT-{2001 + n}"

def create_rental(cid, vid, start, end): #check data valid 
    try: s, e = pdate(start), pdate(end)
    except ValueError: raise BadDateRange("Use YYYY-MM-DD format.")
    if s.date() < datetime.now().date(): raise BadDateRange("Start date cannot be past.")
    if e <= s: raise BadDateRange("End must be after start.")
    v = get_vehicle(vid)
    if v.status != "available": raise NotAvailable(f"'{v.brand_model}' not available.")
    days = (e - s).days
    base = days * v.rate_per_day
    total = base + v.security_dep
    rid = _next_rid()
    db = conn()
    try:
        db.execute("INSERT INTO rentals(rental_id,customer_id,vehicle_id,start_date,end_date,"
                   "total_days,base_charge,security_dep,total_amount,status) VALUES(?,?,?,?,?,?,?,?,?,'active')",
                   (rid, cid, vid, start, end, days, base, v.security_dep, total))
        db.execute("UPDATE vehicles SET status=? WHERE vehicle_id=?", ("rented", vid))
        db.commit(); return rid
    except Exception as e: raise DBError(f"Rental failed: {e}")
    finally: db.close()

def return_rental(rid):
    db = conn()
    try:
        row = db.execute("SELECT r.*,v.brand_model,v.rate_per_day FROM rentals r "
                         "JOIN vehicles v ON r.vehicle_id=v.vehicle_id WHERE r.rental_id=?",
                         (rid,)).fetchone()
        if not row: raise RentalNotFound(f"Rental '{rid}' not found.")
        r = dict(row)
        if r["status"] != "active": raise AlreadyReturned("Already returned.")
        rd = today()
        late = max(0, (pdate(rd) - pdate(r["end_date"])).days)
        fee = late * r["rate_per_day"] * 0.5
        due = r["base_charge"] + fee
        db.execute("UPDATE rentals SET status='completed',return_date=?,late_fee=?,total_amount=? WHERE rental_id=?",
                   (rd, fee, due, rid))
        db.execute("UPDATE vehicles SET status=? WHERE vehicle_id=?", ("available", r["vehicle_id"]))
        db.commit()
        return {"rental_id": rid, "brand_model": r["brand_model"], "start_date": r["start_date"],
                "end_date": r["end_date"], "return_date": rd, "late_days": late,
                "base_charge": r["base_charge"], "late_fee": fee,
                "security_dep": r["security_dep"], "total_due": due}
    finally: db.close()

def user_rentals(cid):
    db = conn()
    rows = db.execute("SELECT r.*,v.brand_model FROM rentals r "
                      "JOIN vehicles v ON r.vehicle_id=v.vehicle_id "
                      "WHERE r.customer_id=? ORDER BY r.id DESC", (cid,)).fetchall()
    db.close(); return [dict(r) for r in rows]

def all_rentals():
    db = conn()
    rows = db.execute("SELECT r.*,v.brand_model,u.full_name FROM rentals r "
                      "JOIN vehicles v ON r.vehicle_id=v.vehicle_id "
                      "JOIN users u ON r.customer_id=u.customer_id ORDER BY r.id DESC").fetchall()
    db.close(); return [dict(r) for r in rows]

def all_customers():
    db = conn()
    rows = db.execute("SELECT customer_id,full_name,email,phone,license_no,created_at FROM users ORDER BY id").fetchall()
    db.close(); return [dict(r) for r in rows]

def stats():
    db = conn(); cur = db.cursor()
    tv  = cur.execute("SELECT COUNT(*) FROM vehicles").fetchone()[0]
    av  = cur.execute("SELECT COUNT(*) FROM vehicles WHERE status='available'").fetchone()[0]
    rv  = cur.execute("SELECT COUNT(*) FROM vehicles WHERE status='rented'").fetchone()[0]
    tu  = cur.execute("SELECT COUNT(*) FROM users").fetchone()[0]
    ar  = cur.execute("SELECT COUNT(*) FROM rentals WHERE status='active'").fetchone()[0]
    rev = cur.execute("SELECT COALESCE(SUM(total_amount),0) FROM rentals WHERE status='completed'").fetchone()[0]
    db.close()
    return {"total_vehicles": tv, "available": av, "rented": rv,
            "total_customers": tu, "active_rentals": ar, "total_revenue": rev}

