# MODELS
class Vehicle(ABC): #abstract base
    def __init__(self, vehicle_id, brand_model, reg_number, year, color, #constructor
                 fuel_type, rate_per_day, security_dep, status="available"):
        self._vid = vehicle_id; self._brand = brand_model; self._reg = reg_number
        self._year = year; self._color = color; self._fuel = fuel_type
        self._rate = rate_per_day; self._dep = security_dep; self._status = status

    @abstractmethod
    def get_type(self): pass
    @abstractmethod
    def capacity_label(self): pass
    @abstractmethod
    def insurance(self): pass

    def daily_total(self): return self._rate + self.insurance() #calculate daily cost
    def info(self):
        return {"vehicle_id": self._vid, "vehicle_type": self.get_type(),
                "brand_model": self._brand, "reg_number": self._reg,
                "year": self._year, "color": self._color, "fuel_type": self._fuel,
                "capacity_label": self.capacity_label(), "rate_per_day": self._rate,
                "insurance": self.insurance(), "security_dep": self._dep, "status": self._status}

    @property
    def vehicle_id(self): return self._vid
    @property
    def brand_model(self): return self._brand
    @property
    def rate_per_day(self): return self._rate
    @property
    def security_dep(self): return self._dep
    @property
    def status(self): return self._status
    @status.setter # allow changes status
    def status(self, v): self._status = v
    def __str__(self): return f"{self.get_type()} | {self._brand} | {self._reg} | Rs.{self._rate}/day"

class Car(Vehicle): #vehicle-PI, car-CI
    def __init__(self, capacity=5, **kw): super().__init__(**kw); self._cap = capacity
    def get_type(self): return "Car"
    def capacity_label(self): return f"{self._cap} Seater"
    def insurance(self): return 50 + self._cap * 5 #polymorphism-same method

class Bike(Vehicle):
    def __init__(self, capacity=150, **kw): super().__init__(**kw); self._cap = capacity
    def get_type(self): return "Bike"
    def capacity_label(self): return f"{self._cap} CC Engine"
    def insurance(self): return 20 + self._cap * 0.05

class Truck(Vehicle):
    def __init__(self, capacity=1.0, **kw): super().__init__(**kw); self._cap = capacity
    def get_type(self): return "Truck"
    def capacity_label(self): return f"{self._cap} Ton Payload"
    def insurance(self): return 100 + self._cap * 50

def make_vehicle(row): #read db row & creates correct V object
    t = row.get("vehicle_type","").lower()
    c = {"vehicle_id": row["vehicle_id"], "brand_model": row["brand_model"],
         "reg_number": row["reg_number"], "year": row["year"], "color": row["color"],
         "fuel_type": row["fuel_type"], "rate_per_day": row["rate_per_day"],
         "security_dep": row["security_dep"], "status": row.get("status","available")}
    cap = row.get("capacity", 5) #return value
    if t == "car":   return Car(capacity=cap, **c)
    if t == "bike":  return Bike(capacity=cap, **c)
    if t == "truck": return Truck(capacity=cap, **c)
    raise ValueError(f"Unknown type: {t}")

