# EXCEPTIONS
class VRSError(Exception):
    def __init__(self, msg): self.message = msg; super().__init__(msg)
class AuthError(VRSError): pass
class BadCredentials(AuthError): pass #raised for wring email,password
class AccountLocked(AuthError): pass  #raised when user enter wrong pass(3)
class DuplicateUser(AuthError): pass  #raised when tries register already registerid
class WeakPassword(AuthError): pass   #raised when it doesn't fit pass validation
class ValidationError(VRSError): pass #raised for unvalide valdation
class BadEmail(ValidationError): pass
class BadPhone(ValidationError): pass
class BadLicense(ValidationError): pass
class VehicleError(VRSError): pass
class VehicleNotFound(VehicleError): pass
class NotAvailable(VehicleError): pass
class DuplicateReg(VehicleError): pass
class RentalError(VRSError): pass
